# 로컬 기본값으로 비워 두면 오프라인 모드(가짜 LLM · 해시 임베더 · 로컬 pgvector)로 돈다
DATABASE_URL=postgresql://ask:ask@localhost:5433/ask
ASK_LLM=fake                 # fake | anthropic
ASK_EMBEDDER=hash            # hash | voyage | gemini
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
GEMINI_API_KEY=
ASK_PROXY_SECRET=            # 운영 필수 — Vercel의 ASK_PROXY_SECRET과 같은 값
ASK_IP_HASH_SECRET=          # 운영 필수 — 임의의 긴 문자열
ASK_DAILY_CAP=300
ASK_DENYLIST_PATH=           # 고객사명 등 — 저장소 밖 파일
